{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shermanator-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_EMAIL": ""
  }
}